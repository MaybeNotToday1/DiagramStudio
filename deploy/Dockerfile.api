FROM maven:3.9.16-eclipse-temurin-21 AS build
WORKDIR /app
COPY server/api/pom.xml ./pom.xml
COPY server/api/src ./src
RUN mvn -B -ntp package
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN groupadd --gid 10001 diagram && useradd --uid 10001 --gid diagram --no-create-home diagram && mkdir /data && chown diagram:diagram /data
COPY --from=build /app/target/diagram-api-0.1.0.jar /app/api.jar
USER diagram
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/api.jar"]
