limit_req_zone $binary_remote_addr zone=pdf_submit:10m rate=6r/m;
server { listen 8080; server_name ${DOMAIN}; return 301 https://${DOMAIN}$request_uri; }
server {
    listen 8443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;
    client_max_body_size 8m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    location = /api/v1/export-jobs {
        limit_req zone=pdf_submit burst=3 nodelay;
        limit_req_status 429;
        proxy_set_header Host $http_host;
        proxy_pass http://api:8080;
    }
    location /api/ { proxy_set_header Host $http_host; proxy_pass http://api:8080; proxy_read_timeout 130s; }
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location /fonts/ { expires 30d; }
    location / { try_files $uri $uri/ /index.html; add_header Cache-Control no-cache; }
}
