{
  "name": "diagram-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "node --import tsx server/worker.mjs",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@antv/x6": "^3.1.7",
    "element-plus": "^2.11.0",
    "elkjs": "^0.11.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.0",
    "node-sql-parser": "^5.3.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "playwright": "1.64.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.0",
    "wawoff2": "^2.0.1",
    "@napi-rs/canvas": "1.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
